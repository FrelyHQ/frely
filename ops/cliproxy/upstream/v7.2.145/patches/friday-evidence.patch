+func safeAuthFailureReason(auth *coreauth.Auth, now time.Time) string {
+	if auth == nil {
+		return ""
+	}
+	unauthorized := false
+	unavailable := auth.Unavailable
+	cooldown := (auth.Quota.Exceeded && auth.Quota.NextRecoverAt.After(now)) || auth.NextRetryAfter.After(now)
+	inspect := func(err *coreauth.Error) {
+		if err == nil {
+			return
+		}
+		switch strings.ToLower(strings.TrimSpace(err.Code)) {
+		case "auth_unauthorized":
+			unauthorized = true
+		case "auth_unavailable":
+			unavailable = true
+		case "model_cooldown":
+			cooldown = true
+		}
+	}
+	inspect(auth.LastError)
+	for _, state := range auth.ModelStates {
+		if state == nil {
+			continue
+		}
+		inspect(state.LastError)
+		unavailable = unavailable || state.Unavailable
+		cooldown = cooldown || (state.Quota.Exceeded && state.Quota.NextRecoverAt.After(now)) || state.NextRetryAfter.After(now)
+	}
+	if unauthorized {
+		return "auth_unauthorized"
+	}
+	if cooldown {
+		return "model_cooldown"
+	}
+	if unavailable {
+		return "auth_unavailable"
+	}
+	return ""
+}
+
