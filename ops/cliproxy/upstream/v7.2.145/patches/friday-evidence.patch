+type authResponseError struct {
+	cause   error
+	payload string
+}
+
+func (e *authResponseError) Error() string { return e.payload }
+func (e *authResponseError) Unwrap() error { return e.cause }
+
+func safeAuthResponseError(err error) error {
+	var authErr *coreauth.Error
+	code := ""
+	if errors.As(err, &authErr) && authErr != nil {
+		code = strings.ToLower(strings.TrimSpace(authErr.Code))
+	}
+	if code == "" && clienterror.HTTPStatusFromError(err) == http.StatusUnauthorized {
+		code = "auth_unauthorized"
+	}
+	message := ""
+	switch code {
+	case "auth_unauthorized":
+		message = "provider credential is unauthorized"
+	case "auth_unavailable":
+		message = "provider credential is temporarily unavailable"
+	case "auth_not_found":
+		message = "provider credential was not found"
+	case "model_cooldown":
+		message = "provider credential is cooling down"
+	default:
+		return err
+	}
+	errType := "server_error"
+	if code == "auth_unauthorized" {
+		errType = "authentication_error"
+	}
+	payload, marshalErr := json.Marshal(ErrorResponse{Error: ErrorDetail{
+		Message: message,
+		Type:    errType,
+		Code:    code,
+	}})
+	if marshalErr != nil {
+		return err
+	}
+	return &authResponseError{cause: err, payload: string(payload)}
