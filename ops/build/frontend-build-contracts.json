      "memory": {
        "containerLimitMiB": 4096,
        "baselineHeapLimitMiB": 640,
        "coldPath": "apps/admin/.output"
      },
      "runtime": {
        "containerPort": 43002,
        "command": [
          "bun",
          "serve.mjs"
        ],
        "readyPath": "/api/health",
        "readyStatuses": [
          200
        ],
        "routes": [
          {
            "path": "/__runtime-contract-not-found",
            "statuses": [
              404
            ]
          }
        ],
        "routeTimeoutMs": 15000,
        "startupTimeoutMs": 30000
      },
      "framework": "tanstack-start",
      "sourcePrerequisites": {
        "requiredPaths": [
          "apps/admin/src",
          "apps/admin/src/routes",
          "apps/admin/src/routeTree.gen.ts",
          "apps/admin/vite.config.mts"
        ],
        "forbiddenPaths": [
          "apps/admin/app",
          "apps/admin/next.config.mjs",
          "apps/admin/next-env.d.ts"
        ]
      },
      "frameworkConfig": {
        "path": "apps/admin/vite.config.mts",
        "requiredRuntimePackages": [
          "@tanstack/react-router",
          "@tanstack/react-start",
          "srvx"
        ],
        "requiredBuildPackages": [
          "@tanstack/router-plugin",
          "@vitejs/plugin-react",
          "vite"
        ],
        "forbiddenPackages": [
          "next"
        ]
      },
      "surface": {
        "kind": "tanstack-file-routes",
        "sourceRoot": "apps/admin/src/routes",
        "registry": "apps/admin/src/telemetry/generated-route-registry.ts",
        "generatedRouteTree": "apps/admin/src/routeTree.gen.ts",
        "buildManifest": "apps/admin/.output/raw/client/.vite/manifest.json",
        "excludePrefixes": [
          "/api/"
        ]
      },
      "build": {
        "command": [
          "bun",
          "run",
          "--filter",
          "@frely/admin",
          "build:framework"
        ],
        "rawRoot": "apps/admin/.output/raw",
        "rawRootEnv": "FRIDAY_RELAY_ADMIN_BUILD_OUT_DIR",
        "artifactRoot": "apps/admin/.output/runtime"
      },
      "artifact": {
        "kind": "tanstack-start-filtered",
        "root": "apps/admin/.output/runtime",
        "sourceRoot": "apps/admin/.output/raw",
        "serverRoot": "server",
        "clientRoot": "client",
        "sourceServerEntry": "server/server.js",
        "entrypoints": [
          "serve.mjs",
          "server/server.js"
        ],
        "launcherSource": "scripts/tanstack-start-runtime-serve.mjs",
        "requiredPackages": [],
        "forbiddenPackages": [
          "@tanstack/router-generator",
          "@tanstack/router-plugin",
          "@tanstack/start-plugin-core",
          "@vitejs/plugin-react",
          "next",
          "typescript",
          "vite"
        ],
        "forbiddenFingerprints": [
          "@tanstack/react-start/plugin/vite",
          "@tanstack/router-plugin",
          "@tanstack/start-plugin-core",
          "@vitejs/plugin-react",
          "This module cannot be imported from a Client Component module.",
          "next/dist/",
          "vite/dist/node"
        ],
        "runtimeIncludes": [
          {
            "source": "packages/postgres/prisma",
            "destination": "server/prisma"
          }
        ]
      },
      "bundle": {
        "kind": "vite-manifest",
        "manifest": "apps/admin/.output/raw/client/.vite/manifest.json",
        "assetsRoot": "apps/admin/.output/raw/client"
      }
    },
