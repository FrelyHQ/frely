          "vite"
        ],
        "forbiddenPackages": [
          "next"
        ]
      },
      "surface": {
        "kind": "tanstack-file-routes",
        "sourceRoot": "apps/web/src/routes",
        "registry": "apps/web/src/telemetry/generated-route-registry.ts",
        "generatedRouteTree": "apps/web/src/routeTree.gen.ts",
        "buildManifest": "apps/web/.output/raw/client/.vite/manifest.json",
        "excludePrefixes": [
          "/api/",
          "/auth/",
          "/oidc/",
          "/activate/",
          "/.well-known/"
        ]
      },
      "build": {
        "command": [
          "bun",
          "run",
          "--filter",
          "@frely/web",
          "build:framework"
        ],
        "rawRoot": "apps/web/.output/raw",
        "rawRootEnv": "FRIDAY_RELAY_WEB_BUILD_OUT_DIR",
        "artifactRoot": "apps/web/.output/runtime"
      },
      "artifact": {
        "kind": "tanstack-start-filtered",
        "root": "apps/web/.output/runtime",
        "sourceRoot": "apps/web/.output/raw",
        "serverRoot": "server",
        "clientRoot": "client",
        "sourceServerEntry": "server/server.js",
        "entrypoints": [
          "serve.mjs",
          "server/server.js"
        ],
        "launcherSource": "scripts/tanstack-start-runtime-serve.mjs",
        "requiredPackages": [],
