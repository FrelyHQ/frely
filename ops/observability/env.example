# Bind the OTLP/HTTP gateway to a private Tailscale address only when the
# observability host firewall also restricts port 10003.
FRIDAY_OBSERVABILITY_OTLP_BIND_ADDRESS=127.0.0.1
FRIDAY_OBSERVABILITY_COLLECTOR_MEMORY_LIMIT=512m
FRIDAY_OBSERVABILITY_COLLECTOR_CPU_LIMIT=0.75
FRIDAY_OBSERVABILITY_PIDS_LIMIT=256
