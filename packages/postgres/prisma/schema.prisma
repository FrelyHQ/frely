generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  previewFeatures        = ["partialIndexes"]
  generatedFileExtension = "ts"
  importFileExtension    = "js"
  moduleFormat           = "esm"
}

datasource db {
  provider = "postgresql"
}

model abuse_rate_limit_counters {
  id             String  @id
  bucket         String
  subject_hash   String
  window_start   BigInt
  window_seconds Int
  count          Int
  blocked_until  BigInt?
  created_at     String
  updated_at     String

  @@unique([bucket, subject_hash, window_start, window_seconds], map: "abuse_rate_limit_counters_window_unique")
  @@index([blocked_until, window_start], map: "abuse_rate_limit_counters_expiry_idx")
}

