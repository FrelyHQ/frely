/// Better Auth's standard identity table. Friday business controls remain in
/// the separate user_controls table and are intentionally not modeled as
/// additional Better Auth fields.
model user {
  id            String    @id
  name          String
  email         String    @unique(map: "user_email_unique")
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @map("updated_at") @db.Timestamptz(3)
  accounts      account[]
  sessions      session[]
  controls      user_controls @relation(fields: [id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "user_controls_id_user_fk")

  @@map("user")
}

/// Better Auth's standard credential/external-account table.
model account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  issuer                String
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @map("updated_at") @db.Timestamptz(3)
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "account_user_id_user_fk")

  @@unique([issuer, accountId], map: "account_issuer_account_id_unique")
  @@index([userId], map: "account_user_id_idx")
  @@map("account")
}

/// Better Auth's standard database-backed session table. The token column
/// contains the project HMAC, never the bearer value sent to a browser.
model session {
  id        String   @id
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  token     String   @unique(map: "session_token_unique")
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "session_user_id_user_fk")

  @@index([userId], map: "session_user_id_idx")
  @@map("session")
}

/// Better Auth's standard one-time verification state. Values are stored as
/// hashes by the runtime adapter/configuration and consumed atomically.
model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @map("updated_at") @db.Timestamptz(3)

  @@index([identifier], map: "verification_identifier_idx")
  @@map("verification")
}
