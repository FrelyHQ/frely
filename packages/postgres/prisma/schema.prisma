model AccessPointTarget {
  id                      String                      @id
  accessPointId           String                      @map("access_point_id")
  targetType              String                      @map("target_type")
  targetAccessPointId     String?                     @map("target_access_point_id")
  targetProviderId        String?                     @map("target_provider_id")
  targetProviderModelName String?                     @map("target_provider_model_name")
  targetProviderModelId   String?                     @map("target_provider_model_id")
  position                Int
  status                  String
  removedAt               String?                     @map("removed_at")
  createdAt               String                      @map("created_at")
  updatedAt               String                      @map("updated_at")
  accessPoint             AccessPoint                 @relation("access_point_targets_access_point_idToaccess_points", fields: [accessPointId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "access_point_targets_access_point_id_access_points_fk_1")
  targetAccessPoint       AccessPoint?                @relation("access_point_targets_target_access_point_idToaccess_points", fields: [targetAccessPointId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "access_point_targets_target_access_point_id_access_points_fk_2")
  provider                providers?                  @relation(fields: [targetProviderId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "access_point_targets_target_provider_id_providers_fk_3")
  targetProviderModel     provider_models?            @relation("access_point_targets_target_provider_model_idToprovider_models", fields: [targetProviderModelId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "access_point_targets_provider_model_fk")
  providerAttempts        request_provider_attempts[]

  @@unique([accessPointId, position], map: "access_point_targets_enabled_position_unique", where: raw("((removed_at IS NULL) AND (status = 'enabled'::text))"))
  @@index([accessPointId, status, position], map: "access_point_targets_access_point_status_idx")
  @@index([accessPointId, position], map: "access_point_targets_position_idx")
  @@index([targetAccessPointId], map: "access_point_targets_target_access_point_idx")
  @@index([targetAccessPointId, accessPointId, id], map: "access_point_targets_inbound_active_idx", where: raw("((removed_at IS NULL) AND (target_access_point_id IS NOT NULL))"))
  @@index([targetProviderId, targetProviderModelName], map: "access_point_targets_target_provider_idx")
  @@index([targetProviderModelId, accessPointId, id], map: "access_point_targets_target_provider_model_id_idx", where: raw("(target_provider_model_id IS NOT NULL)"))
  @@map("access_point_targets")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model AccessPoint {
  id                            String                       @id
  ownerId                       String                       @map("owner_id")
  scopeRef                      String                       @map("scope_ref")
  name                          String
  description                   String?
  apiFamily                     String                       @map("api_family")
  exposedModel                  String                       @map("exposed_model")
  targetModel                   String                       @map("target_model")
  routingRuleId                 String                       @default("direct") @map("selector_id")
  routingRuleBehaviorVersion    Int                          @default(1) @map("selector_behavior_version")
  routingRuleConfigJson         String                       @default("{}") @map("selector_config_json")
  requestOverridesJson          String                       @default("{}") @map("request_overrides_json")
  routingRevision               Int                          @default(1) @map("routing_revision")
  legacyTargetType              String                       @map("target_type")
  legacyTargetId                String?                      @map("target_id")
  legacyTargetProviderId        String?                      @map("target_provider_id")
  legacyTargetProviderModelName String?                      @map("target_provider_model_name")
  priority                      Int
  weight                        Int
  fallbackOrder                 Int                          @map("fallback_order")
  status                        String
  removedAt                     String?                      @map("removed_at")
  createIdempotencyKeyHash      String?                      @map("creation_idempotency_key_hash")
  createRequestHash             String?                      @map("creation_request_hash")
  createdAt                     String                       @map("created_at")
  updatedAt                     String                       @map("updated_at")
  prices                        access_point_prices[]
  targets                       AccessPointTarget[]          @relation("access_point_targets_access_point_idToaccess_points")
  inboundTargets                AccessPointTarget[]          @relation("access_point_targets_target_access_point_idToaccess_points")
  billingEdges                  billing_access_point_edges[] @relation("billing_access_point_edges_access_point_idToaccess_points")
  billingTargetEdges            billing_access_point_edges[] @relation("billing_access_point_edges_target_access_point_idToaccess_points")
  planPrices                    plan_access_point_prices[]
  planReferences                plan_access_points[]
  requestLogs                   request_logs[]
  providerAttempts              request_provider_attempts[]
  personalProviderSlot          user_provider_slots?         @relation(fields: [personalProviderSlotId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "access_points_personal_provider_slot_id_fk")
  personalProviderSlotId        String?                      @map("personal_provider_slot_id")

  @@index([ownerId, priority], map: "access_points_owner_idx")
  @@index([ownerId, status, priority, fallbackOrder, createdAt], map: "access_points_owner_status_order_idx")
  @@unique([scopeRef, createIdempotencyKeyHash], map: "access_points_create_idempotency_unique", where: raw("(creation_idempotency_key_hash IS NOT NULL)"))
  @@index([scopeRef, id], map: "access_points_scope_occupancy_idx", where: raw("(removed_at IS NULL)"))
  @@index([personalProviderSlotId, id], map: "access_points_personal_slot_occupancy_idx", where: raw("((personal_provider_slot_id IS NOT NULL) AND (removed_at IS NULL))"))
  @@index([scopeRef, status, exposedModel, priority, fallbackOrder, createdAt], map: "access_points_scope_status_order_idx")
  @@index([legacyTargetType, legacyTargetId], map: "access_points_target_idx")
  @@index([legacyTargetProviderId, legacyTargetProviderModelName], map: "access_points_target_provider_idx")
  @@map("access_points")
}

