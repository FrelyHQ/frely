{
  "name": "@frely/db-ops",
  "version": "0.64.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prisma:validate": "bun run --filter @frely/postgres prisma:validate",
    "prisma:generate": "bun run --filter @frely/postgres prisma:generate",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@dsnp/parquetjs": "1.8.8",
    "@frely/application": "workspace:*",
    "@frely/audit": "workspace:*",
    "@frely/authority": "workspace:*",
    "@frely/billing": "workspace:*",
    "@frely/auth": "workspace:*",
    "@frely/capture": "workspace:*",
    "@frely/config": "workspace:*",
    "@frely/core": "workspace:*",
    "@frely/identity": "workspace:*",
    "@frely/model-access": "workspace:*",
    "@frely/observability": "workspace:*",
    "@frely/pi-tunnel": "workspace:*",
    "@frely/postgres": "workspace:*",
    "@frely/provider-runtime": "workspace:*",
    "@frely/request-execution": "workspace:*",
    "@frely/tenancy-context": "workspace:*",
    "canonicalize": "^3.0.0",
    "fast-json-patch": "^3.1.1",
    "pg": "^8.22.0",
    "pg-copy-streams": "^7.0.0",
    "undici": "^8.9.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.3",
    "@types/pg-copy-streams": "^1.2.5",
    "prisma": "7.9.1"
  },
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/FrelyHQ/frely.git"
  }
