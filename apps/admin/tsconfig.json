{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "incremental": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "vite.config.mts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
